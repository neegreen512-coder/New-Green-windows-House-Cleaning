# Public URL of the deployed CMS worker. Defaults to http://localhost:8787 in dev.
NEXT_PUBLIC_CMS_URL=http://localhost:8787

# Admin secret shared with the CMS worker (SERVER-ONLY, never exposed to the browser).
# Required in production so the /api/admin proxy can reach the secret-gated CMS admin API.
# Locally, if the worker has no ADMIN_SECRET set, this can be left blank.
# IMPORTANT: in production, protect /admin AND /api/admin/* with Cloudflare Access.
CMS_ADMIN_SECRET=

# Admin login password (SERVER-ONLY). Owner signs in at /admin with this.
ADMIN_PASSWORD=

# Cloudflare Turnstile site key (PUBLIC, safe to expose). From Cloudflare
# dashboard -> Turnstile -> add a widget. Leave blank to disable the CAPTCHA
# (the honeypot + rate limit still protect the forms). The matching secret key
# goes on the CMS worker as TURNSTILE_SECRET (see cms/.dev.vars.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
