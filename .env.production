# Baked into the production build (public, not a secret).
# Points the site at the deployed CMS worker.
NEXT_PUBLIC_CMS_URL=https://newgreen-cms.neegreen512.workers.dev

# Cloudflare Turnstile site key (public by design). Enables the CAPTCHA widget on
# the quote, contact, review, and admin-login forms. The matching secret key is
# a Worker secret (TURNSTILE_SECRET), never committed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEy9tkqqEdU8lK02
